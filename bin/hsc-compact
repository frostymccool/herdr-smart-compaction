#!/usr/bin/env python3
"""Detach, wait for this pane to go idle, then type /compact. Usage: hsc-compact [focus text]"""
import os, subprocess, sys
here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.insert(0, here)
from hsc import core

pane = os.environ.get("HERDR_PANE_ID")
if not pane:
    print("hsc-compact: HERDR_PANE_ID not set (not in a herdr pane); not compacting")
    sys.exit(1)
if os.environ.get("HSC_CHILD") != "1":
    env = dict(os.environ, HSC_CHILD="1")
    subprocess.Popen([sys.executable, os.path.realpath(__file__), *sys.argv[1:]], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    print("compaction scheduled: will run when this session goes idle")
    sys.exit(0)
result = core.compact_when_idle(pane, core.HerdrOps(), focus=" ".join(sys.argv[1:]))
os.makedirs(core.STATE_DIR, exist_ok=True)
with open(os.path.join(core.STATE_DIR, "compact.log"), "a") as f:
    f.write("%s pane=%s %s\n" % (core.time.strftime("%F %T"), pane, result))
